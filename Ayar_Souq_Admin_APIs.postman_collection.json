{
	"info": {
		"_postman_id": "admin-gold-souq-apis",
		"name": "Ayar Souq - Admin APIs",
		"description": "Comprehensive Admin API collection for Ayar Souq backend project. Includes all admin endpoints with authentication, validation, and examples.\n\n## Authentication\nAll admin endpoints require:\n1. **JWT Token** in Authorization header\n2. **Admin Role** verification\n\n## Base URL\n`{{baseUrl}}/AyarSouqAPIs/api`\n\n## Collections Included\n- **Admin Authentication** - Signin, password reset & change password\n- **Categories Management** - CRUD operations for categories\n- **Posts/Ads Management** - List, approve, reject, update & delete user posts\n- **Users Management** - User administration\n- **Metals Pricing** - Metal prices management & daily notifications\n- **Notifications Management** - Send, list & delete multi-language notifications",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🔐 Admin Authentication",
			"item": [
				{
					"name": "Admin Signin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Admin token received', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('token');",
									"    pm.expect(jsonData.data.role).to.eql('admin');",
									"    pm.environment.set('adminToken', jsonData.data.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phoneNumber\": \"{{adminPhoneNumber}}\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/AyarSouqAPIs/api/admin/auth/signin",
							"host": ["{{baseUrl}}"],
							"path": ["AyarSouqAPIs", "api", "admin", "auth", "signin"]
						},
						"description": "Admin login to get JWT token. Uses phone number + password and requires the 'admin' role."
					},
					"response": []
				},
