		{
			"name": "Current Metals Prices",
			"item": [
				{
					"name": "Get Current Prices - UAE (AED)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has success status\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"success\");",
									"    pm.expect(jsonData.message).to.eql(\"success\");",
									"});",
									"",
									"pm.test(\"Response contains metals data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property(\"metals\");",
									"    pm.expect(jsonData.data).to.have.property(\"country\");",
									"    pm.expect(jsonData.data).to.have.property(\"currency\");",
									"    pm.expect(jsonData.data).to.have.property(\"exchange_rate\");",
									"});",
									"",
									"pm.test(\"Gold has carat calculations\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data.metals.gold) {",
									"        pm.expect(jsonData.data.metals.gold).to.have.property(\"by_carat\");",
									"        pm.expect(jsonData.data.metals.gold.by_carat).to.have.property(\"24k\");",
									"        pm.expect(jsonData.data.metals.gold.by_carat).to.have.property(\"22k\");",
									"        pm.expect(jsonData.data.metals.gold.by_carat).to.have.property(\"21k\");",
									"        pm.expect(jsonData.data.metals.gold.by_carat).to.have.property(\"18k\");",
									"        pm.expect(jsonData.data.metals.gold.by_carat).to.have.property(\"14k\");",
									"    }",
